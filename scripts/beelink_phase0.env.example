# Phase 0 验证脚本环境变量样例。
# 复制为 .env 或直接 export 后再运行 scripts/beelink_phase0_probe.py。
# 真实账号密码不要提交到 git。

# beelink 后端基址（不要带尾部斜杠），默认 9047 端口
BEELINK_URL=http://localhost:9047

# beelink 中的用户名/密码
BEELINK_USER=zhangsan01
BEELINK_PASS=请填写真实密码

# 可选：要展开 children 的 catalog item id。
# 留空则自动挑顶层第一个 SOURCE 展开。
BEELINK_SOURCE_ID=

# 可选：用于步骤 4 提交的测试 SQL。
# 默认 SELECT 1 AS n（注意：Dremio 把 "one" 当保留字，别名别用 one）。
# 可改成业务表的轻量 SELECT。
BEELINK_TEST_SQL=SELECT 1 AS n

# 可选：单次 HTTP 超时（秒），默认 15
BEELINK_TIMEOUT=15

# 可选：是否忽略 TLS 证书校验（默认 1=忽略，便于自签证书的开发环境）
# 生产环境务必置 0
BEELINK_INSECURE=1
